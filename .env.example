# App
APP_NAME=sender.report
# Internal listen addresses INSIDE the container — do NOT change these when using Docker.
# Docker maps the host ports (HTTP_PORT / SMTP_PORT below) to these internal addresses.
# Changing these here without adjusting docker-compose.yml will break the port mapping.
HTTP_LISTEN_ADDR=:8080
SMTP_LISTEN_ADDR=:2525
# Optional overrides. Leave empty to derive these from the incoming request host.
PUBLIC_BASE_URL=
SMTP_DOMAIN=

# Optional direct TLS for the built-in web server.
# If ENABLE_TLS=true, both TLS_CERT_FILE and TLS_KEY_FILE must point to mounted files.
# FORCE_HTTPS redirects plain HTTP requests to HTTPS when the app receives HTTP traffic
# directly or via trusted reverse-proxy forwarded headers.
ENABLE_TLS=false
TLS_CERT_FILE=
TLS_KEY_FILE=
FORCE_HTTPS=false
# Paths that answer over plain HTTP although FORCE_HTTPS is set, so the
# healthcheck inside the container reaches them on http://127.0.0.1
# regardless of PUBLIC_BASE_URL. Comma-separated; an entry ending in / covers
# the paths below it; none redirects every path.
FORCE_HTTPS_EXEMPT_PATHS=/healthz,/readyz

# Container image from CI registry (adjust owner/repo)
SENDER_REPORT_IMAGE=ghcr.io/brightcolor/sender-report:latest

# Runtime paths
DATA_DIR=/data
DB_PATH=/data/sender-report.db

# Lifetime & cleanup
MAILBOX_TTL=24h
DATA_RETENTION_TTL=168h
CLEANUP_INTERVAL=30m

# Abuse protection
MAX_MESSAGE_BYTES=2097152
MAX_ACTIVE_MAILBOXES_PER_IP=20
MAX_ACTIVE_MAILBOXES_GLOBAL=2000
WEB_RATE_LIMIT_PER_MIN=60
WEB_BURST_PER_10_SEC=20
SMTP_RATE_LIMIT_PER_HOUR=200
SMTP_BURST_PER_MIN=40
# Encrypted reports one IP address may fetch per minute (1 to 600). Rechecks and
# simulator runs each count separately against the same number.
PAYLOAD_RATE_LIMIT_PER_MIN=30
# Comma-separated reverse proxy CIDRs whose X-Forwarded-For header is trusted.
TRUSTED_PROXY_CIDRS=

# Optional checks
ENABLE_RBL_CHECKS=false
RBL_PROVIDERS=zen.spamhaus.org,bl.spamcop.net,b.barracudacentral.org,psbl.surriel.com,dnsbl.dronebl.org,bl.blocklist.de

# Opt-in third-party reputation checks. These contact EXTERNAL services with the
# sender/link domain and are therefore OFF by default for privacy. If you enable
# them, make sure your privacy policy reflects it (see /privacy) and use your own
# DNS resolver (public resolvers like 8.8.8.8 are blocked by Spamhaus).
#   ENABLE_DOMAIN_AGE       : domain registration age via RDAP (rdap.org)
#   ENABLE_DOMAIN_BLOCKLIST : sender + link domains against domain/URI blocklists
ENABLE_DOMAIN_AGE=false
ENABLE_DOMAIN_BLOCKLIST=false
DOMAIN_BLOCKLIST_PROVIDERS=dbl.spamhaus.org,multi.uribl.com
ENABLE_SPAMASSASSIN=false
SPAMASSASSIN_HOSTPORT=spamd:783
ENABLE_RSPAMD=false
RSPAMD_URL=http://rspamd:11334/checkv2
RSPAMD_PASSWORD=
ENABLE_REDIS=false
REDIS_ADDR=redis:6379

# Optional alerting webhook (JSON POST on processing failures)
ALERT_WEBHOOK_URL=

# Privacy page operator contact (shown in the "Wer ist verantwortlich?" section)
# Leave empty to show the generic placeholder text.
PRIVACY_OPERATOR_NAME=
PRIVACY_OPERATOR_ADDRESS=
PRIVACY_OPERATOR_EMAIL=
# Set to true once you have filled in your operator details to hide the setup note.
PRIVACY_HIDE_TEMPLATE_NOTE=false

# Web interface: display option for visitors who have not picked one in the
# navbar menu yet. auto follows the visitor's system setting; light, dark and
# werkbank (the workbench look on top of light) fix it for new visitors.
UI_DEFAULT_THEME=auto

# Cookies. COOKIE_SECURE sets the Secure attribute: auto on requests that came
# in over HTTPS (directly or through TRUSTED_PROXY_CIDRS) and on every request
# once PUBLIC_BASE_URL starts with https://; always on every request; never for
# test setups that serve plain HTTP only.
COOKIE_SECURE=auto
# Cookie with the language picked in the switcher, kept for LANG_COOKIE_DAYS
# days (1 to 400, the longest lifetime browsers grant).
LANG_COOKIE_NAME=sr_lang
LANG_COOKIE_DAYS=365
# Cookie with the mailbox created through the form without JavaScript.
MAILBOX_COOKIE_NAME=sr_mailbox

# Runtime ports mapped by docker-compose
# HTTP_PORT: host port for the web UI (container always listens on :8080 internally)
HTTP_PORT=9090
# SMTP_PORT: host port for inbound SMTP. External mail servers (Gmail, etc.) always
# connect on port 25. Set SMTP_PORT=25 in production and make sure no other MTA
# (postfix, exim, sendmail) is running. Port 2525 is only for local testing.
SMTP_PORT=25
HEALTHCHECK_URL=http://127.0.0.1:9090/healthz

# Env migration — path inside the container to the mounted .env file.
# When set, the binary appends any missing variables on every startup so your
# .env stays in sync after a Watchtower pull without manual intervention.
# The default docker-compose.yml mounts ./.env here automatically.
ENV_FILE=/config/.env

# ── Inbox Placement Testing ───────────────────────────────────────────────────
# Operator-konfigurierte Seed-Konten für echte Inbox-Zustellungstests.
# Erfordert eine seeds.json (siehe seeds.json.example) und ein Volume-Mount.
ENABLE_INBOX_PLACEMENT=false
SEED_ACCOUNTS_FILE=/config/seeds.json
# How often to check seed account connectivity (default 6h).
IPT_CHECK_INTERVAL=6h
# Placement tests one IP address may start per hour (1 to 60). Each test logs
# in to the seed accounts throughout its run; the upper bound keeps providers
# from locking them.
IPT_RATE_LIMIT_PER_HOUR=3
# Length of the random token in the subject of a new placement test, in
# hexadecimal characters of 4 bits each (16 to 64; 32 = 128 bits). A test
# with a shorter token answers to it until the test expires.
IPT_TOKEN_LENGTH=32
# How long a placement test waits for its message, in whole minutes (1m to
# 1h). The placement dialog names this duration.
IPT_TEST_DURATION=10m
# Pause between two IMAP lookups in one seed account (5s to 5m), shorter than
# IPT_TEST_DURATION.
IPT_POLL_INTERVAL=30s
# How often the open placement dialog receives the state of its test (1s to 1m).
IPT_EVENTS_INTERVAL=5s
# How far before the start of a test the IMAP search reaches back (0s to 1h),
# so a provider whose clock runs behind still finds the message.
IPT_SEARCH_MARGIN=2m
# Folders a placement test searches after INBOX, in this order, separated by
# commas (at most 20); none searches INBOX alone.
IPT_SPAM_FOLDERS=Spam,Junk,[Gmail]/Spam,Bulk Mail,Bulk,Junk E-Mail
# Admin email address to receive alerts when a seed account fails.
# Leave empty to disable email alerts.
IPT_ALERT_EMAIL=
# Outbound SMTP for alert emails. Port 465 = implicit TLS; 587 = STARTTLS.
IPT_ALERT_SMTP_ADDR=mail.example.com:587
IPT_ALERT_SMTP_FROM=sender-report@example.com
IPT_ALERT_SMTP_USER=
IPT_ALERT_SMTP_PASS=
# Include raw IMAP error text in alert emails (default true).
IPT_ALERT_INCLUDE_RAW_ERRORS=true
